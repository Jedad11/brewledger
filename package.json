{
  "name": "brewledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --filter @brewledger/console dev",
    "dev:api": "pnpm --filter @brewledger/api start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:boundary": "eslint . -c eslint.config.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @brewledger/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @brewledger/db exec prisma db seed",
    "db:reset": "pnpm --filter @brewledger/db exec prisma migrate reset --force",
    "db:generate": "pnpm --filter @brewledger/db exec prisma generate",
    "db:validate": "pnpm --filter @brewledger/db exec prisma validate"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-plugin-import": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
