{
  "name": "brewledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "predev": "pnpm --filter @brewledger/shared --filter @brewledger/ui build",
    "dev": "pnpm --filter @brewledger/console dev",
    "predev:shop": "pnpm --filter @brewledger/shared --filter @brewledger/ui build",
    "dev:shop": "pnpm --filter @brewledger/shop dev",
    "predev:worker": "pnpm --filter @brewledger/shared build",
    "dev:worker": "pnpm --filter @brewledger/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:boundary": "eslint . -c eslint.config.mjs",
    "lint:functions": "eslint supabase/functions -c supabase/functions/eslint.config.mjs",
    "lint:lifecycle": "node scripts/scan-order-status-bypass.mjs",
    "functions:serve": "supabase functions serve --import-map supabase/functions/deno.json",
    "lint:adherence": "node scripts/lint-adherence.mjs",
    "scan:forbidden-fields": "node scripts/scan-forbidden-fields.mjs",
    "scan:forbidden-fields:bundle": "node scripts/scan-forbidden-fields-bundle.mjs",
    "scan:forbidden-copy": "node scripts/scan-forbidden-copy.mjs",
    "ops:check-quota": "node scripts/check-quota.mjs",
    "ops:restore-drill": "node scripts/restore-drill.mjs",
    "test:lint-no-db-row-spread": "bash scripts/test-lint-no-db-row-spread-regression.sh",
    "test:functions-import-boundary": "bash scripts/test-functions-import-boundary-regression.sh",
    "typecheck": "pnpm --filter @brewledger/shared --filter @brewledger/ui build && pnpm -r typecheck",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked > packages/db/src/types.ts",
    "db:perf-seed": "pnpm --filter @brewledger/db perf-seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "^8",
    "eslint": "^9",
    "eslint-plugin-import": "^2",
    "husky": "^9.1.7",
    "oxlint": "^1.78.0",
    "pg": "^8.23.0",
    "supabase": "2.115.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
