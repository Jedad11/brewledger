{
  "name": "brewledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --filter @brewledger/console dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:boundary": "eslint . -c eslint.config.mjs",
    "lint:functions": "eslint supabase/functions -c supabase/functions/eslint.config.mjs",
    "lint:adherence": "node scripts/lint-adherence.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @brewledger/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @brewledger/db exec prisma db seed",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked > packages/db/src/types.ts",
    "db:generate": "pnpm --filter @brewledger/db exec prisma generate",
    "db:validate": "pnpm --filter @brewledger/db exec prisma validate"
  },
  "devDependencies": {
    "@typescript-eslint/utils": "^8",
    "eslint": "^9",
    "eslint-plugin-import": "^2",
    "oxlint": "^1.78.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
