{
  "name": "@brewledger/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": "./dist/src/index.js",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./tailwind-preset": "./dist/tailwind-preset.js"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "pnpm build:tokens && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:fidelity": "node scripts/verify-fidelity.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "postcss": "^8",
    "postcss-value-parser": "^4",
    "playwright": "^1.51.1",
    "typescript": "^5",
    "vitest": "^4"
  }
}
