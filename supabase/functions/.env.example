# WBS 4.1 — required by console-auth-request-otp (via _shared/auth/rateLimit.ts)
# to HMAC-hash phone numbers/IPs before writing to auth_attempts. Any long
# random string works locally; copy to supabase/functions/.env (gitignored)
# with a real value before running `supabase functions serve`.
#
# On the hosted brewledger-dev/prod projects this is set with:
#   supabase secrets set AUTH_ATTEMPTS_HASH_SALT=<random value> --project-ref <ref>
# never committed, never reused across environments.
AUTH_ATTEMPTS_HASH_SALT=

# WBS 3.7 — required by public-menu to build a browser-fetchable image URL
# (packages/shared/src/serializers/public.ts's toPublicMenuItem). Deliberately
# NOT read from SUPABASE_URL, and deliberately NOT named with a SUPABASE_
# prefix at all:
#   - SUPABASE_URL is reserved (auto-injected by the CLI/platform, cannot be
#     set via `supabase secrets set` or this .env file) and locally the CLI's
#     Docker Compose network sets it to the edge-runtime container's internal
#     view of Kong (`http://kong:8000`), unreachable from a host browser. On
#     Supabase Cloud SUPABASE_URL happens to already be the public
#     `https://<project-ref>.supabase.co` URL, but this function does not
#     rely on that coincidence — it reads its own explicit var so the same
#     code path is correct in both environments.
#   - Confirmed live (2026-08-22): `supabase functions serve` silently drops
#     ANY .env entry whose name starts with `SUPABASE_`, logging "Env name
#     cannot start with SUPABASE_, skipping" — not just the four reserved
#     exact names. A var meant to be actually settable must avoid that
#     prefix entirely, hence `PROJECT_PUBLIC_URL` below.
#
# Locally: the URL apps/shop's browser actually talks to, i.e.
# apps/shop/.env.local's NEXT_PUBLIC_SUPABASE_URL (http://127.0.0.1:54321).
# On the hosted brewledger-dev/prod projects this is set with:
#   supabase secrets set PROJECT_PUBLIC_URL=https://<project-ref>.supabase.co --project-ref <ref>
# (same value as that project's apps/shop production NEXT_PUBLIC_SUPABASE_URL).
PROJECT_PUBLIC_URL=
