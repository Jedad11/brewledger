# WBS 4.1 — required by console-auth-request-otp (via _shared/auth/rateLimit.ts)
# to HMAC-hash phone numbers/IPs before writing to auth_attempts. Any long
# random string works locally; copy to supabase/functions/.env (gitignored)
# with a real value before running `supabase functions serve`.
#
# On the hosted brewledger-dev/prod projects this is set with:
#   supabase secrets set AUTH_ATTEMPTS_HASH_SALT=<random value> --project-ref <ref>
# never committed, never reused across environments.
AUTH_ATTEMPTS_HASH_SALT=
