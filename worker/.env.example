SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # server-only, bypasses RLS, Render env var only
DATABASE_URL=                    # pooler connection string
# FLOAT16_API_KEY=                # optional (WBS 6.2 not built) — leave unset, not blank: z.string().min(1).optional() rejects an empty string
# VAPID_PRIVATE_KEY=              # optional (WBS 5.8 not built) — same
SENTRY_DSN=                       # optional (WBS 3.11) — absent = Sentry no-ops, no startup crash
ALERT_WEBHOOK_URL=                # optional (WBS 3.10/3.11) — absent = alerts log a warning and drop
